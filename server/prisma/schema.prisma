// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Ссылка на базу из .env
}

model RwaProfiles {
  id          Int       @id@default(autoincrement())
  firstName   String    @db.VarChar(50)
  lastName    String    @db.VarChar(50)

}